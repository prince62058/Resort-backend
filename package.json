{
  "name": "nature-nest-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "build": "node scripts/check.js",
    "start": "node server/index.js",
    "test": "node --test tests/server/*.test.js",
    "test:integration": "node tests/integration/system.mjs",
